{
  "manifest_version": 3,
  "name": "Focus Reminder",
  "description": "Set gentle timers for websites you want to limit, then close the tab when time is up.",
  "version": "1.0.0",
  "action": {
    "default_title": "Focus Reminder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
